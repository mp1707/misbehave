    "Add connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung hinzufügen"
          }
        }
      }
    },
    "Add demo connection" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo-Verbindung hinzufügen"
          }
        }
      }
    },
    "All connections end for you and your partners, and every point is deleted. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Verbindungen enden für dich und deine Partner, und jeder Punkt wird gelöscht. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
    "All five need a green check for notifications to arrive while the app is closed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle fünf brauchen einen grünen Haken, damit Mitteilungen bei geschlossener App ankommen."
          }
        }
      }
    },
    "Allow notifications" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen erlauben"
          }
        }
      }
    },
    "Allow notifications to hear about it the moment your partner gives or takes a point." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mitteilungen, um sofort zu erfahren, wenn dein Partner dir einen Punkt gibt oder abzieht."
