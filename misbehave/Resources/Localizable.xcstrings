    },
    "Later" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Später"
          }
        }
      }
    },
    "Let's keep score. Open this on your iPhone to connect with me on misbehave." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass uns Punkte zählen. Öffne den Link auf deinem iPhone, um dich in misbehave mit mir zu verbinden."
