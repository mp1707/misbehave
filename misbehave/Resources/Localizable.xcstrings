{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ ended your connection. Its points are gone on both phones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eure Verbindung beendet. Die Punkte sind auf beiden iPhones gelöscht."
          }
        }
      }
    },
    "%@ point" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Punkt"
          }
        }
      }
    },
    "%@ points" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Punkte"
          }
        }
      }
    },
    "%@'s %@ points" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@-Punkte von %1$@"
