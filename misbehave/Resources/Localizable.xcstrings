            "value" : "Aus"
          }
        }
      }
    },
    "On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An"
          }
        }
      }
    },
    "On your iPhone and in iCloud. Each connection lives in the iCloud account of the person who sent the invitation and is shared only with the one partner who accepted it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem iPhone und in iCloud. Jede Verbindung liegt im iCloud-Account der Person, die eingeladen hat, und ist nur mit dem einen Partner geteilt, der die Einladung angenommen hat."
          }
        }
      }
    },
    "Open Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        }
      }
    },
    "Privacy" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenschutz"
          }
        }
      }
    },
    "Push registration" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-Registrierung"
          }
        }
      }
    },
    "Remove demo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo entfernen"
          }
        }
      }
    },
    "Remove the demo connection?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo-Verbindung entfernen?"
          }
        }
      }
    },
    "Role" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolle"
          }
        }
      }
    },
    "Saved on this iPhone. Your partner gets it as soon as iCloud is reachable." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPhone gespeichert. Dein Partner bekommt es, sobald iCloud erreichbar ist."
          }
        }
      }
    },
    "Send invitation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einladung senden"
          }
        }
      }
    },
    "Send it to your partner. It works exactly once, so nobody else can join with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick ihn deinem Partner. Er funktioniert genau einmal, niemand sonst kann damit beitreten."
          }
        }
      }
    },
    "Send the invitation link to your partner. It only works on their iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick den Einladungslink deinem Partner. Er funktioniert nur auf dessen iPhone."
          }
        }
      }
    },
    "Send the link again" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link noch einmal senden"
          }
        }
      }
    },
    "Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        }
      }
    },
    "Setup" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrichtung"
          }
        }
      }
    },
    "Sign in to iCloud in the Settings app to connect with a partner." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich in der Einstellungen-App bei iCloud an, um dich mit einem Partner zu verbinden."
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Status"
          }
        }
      }
    },
    "Subscription, accepted invitations" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abo, angenommene Einladungen"
          }
        }
      }
    },
    "Subscription, own invitations" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abo, eigene Einladungen"
          }
        }
      }
    },
    "Take a point away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt abziehen"
          }
        }
      }
    },
    "That didn't work. Check your internet connection and iCloud, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Prüfe Internetverbindung und iCloud und versuch es noch einmal."
          }
        }
      }
    },
    "That's your own link" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist dein eigener Link"
          }
        }
      }
    },
    "The demo partner mirrors what you do. Nothing here leaves your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Demo-Partner macht dir alles nach. Nichts davon verlässt dein iPhone."
          }
        }
      }
    },
    "The invitation may have been used already, or iCloud isn't reachable. Ask for a new link and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einladung wurde vielleicht schon verwendet, oder iCloud ist nicht erreichbar. Bitte um einen neuen Link und versuch es noch einmal."
          }
        }
      }
    },
    "The link stops working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link funktioniert dann nicht mehr."
          }
        }
      }
    },
    "The link was created on another device and can only be sent from there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link wurde auf einem anderen Gerät erstellt und kann nur von dort verschickt werden."
          }
        }
      }
    },
    "The link works exactly once. As soon as your partner opens it on their iPhone, you're connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link funktioniert genau einmal. Sobald dein Partner ihn auf seinem iPhone öffnet, seid ihr verbunden."
          }
        }
      }
    },
    "The points of this connection are deleted for both of you. Your other connections stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
