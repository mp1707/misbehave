    "You" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du"
          }
        }
      }
    },
    "You and the partner of that connection. The developer has no server and cannot see any of it. There is no tracking, no advertising and no analytics." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du und der Partner dieser Verbindung. Der Entwickler betreibt keinen Server und kann nichts davon sehen. Es gibt kein Tracking, keine Werbung und keine Analyse."
          }
        }
      }
    },
    "You'll be %@ in this connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Verbindung bist du %@."
          }
        }
      }
    },
    "You'll see new points when you open the app. You can turn notifications on in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Punkte siehst du, wenn du die App öffnest. Mitteilungen kannst du in den Einstellungen einschalten."
          }
        }
      }
    },
