    "What happened" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was passiert ist"
          }
        }
      }
    },
    "What is stored" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was gespeichert wird"
          }
        }
      }
    },
    "When your partner gives you a point, your iPhone tells you right away and the widget follows. Without notifications you only see it when you open the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein Partner dir einen Punkt gibt, meldet sich dein iPhone sofort und das Widget zieht nach. Ohne Mitteilungen siehst du es erst, wenn du die App öffnest."
          }
        }
      }
    },
    "Where it is stored" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo es gespeichert wird"
          }
        }
      }
    },
    "Which one are you?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was bist du?"
