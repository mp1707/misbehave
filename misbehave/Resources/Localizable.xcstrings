    "Disconnect" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trennen"
          }
        }
      }
    },
    "Disconnect from %@?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung mit %@ trennen?"
          }
        }
      }
    },
    "Disconnect removes one connection with all its points for both of you. \"Delete all data\" in Settings removes everything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Trennen“ entfernt eine Verbindung mit all ihren Punkten für euch beide. „Alle Daten löschen“ in den Einstellungen entfernt alles."
          }
        }
      }
    },
    "Dismiss" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausblenden"
          }
        }
      }
    },
    "Don't miss the moment" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpass den Moment nicht"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        }
      }
    },
    "Ends every connection and removes your profile and all points from this iPhone and from iCloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet jede Verbindung und entfernt dein Profil und alle Punkte von diesem iPhone und aus iCloud."
          }
        }
      }
    },
    "Give a point" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt geben"
          }
        }
      }
    },
    "Give a point from the other iPhone while this app is closed, then open this page. The times show how far the push got." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib vom anderen iPhone einen Punkt, während diese App geschlossen ist, und öffne dann diese Seite. Die Zeiten zeigen, wie weit der Push gekommen ist."
          }
        }
      }
    },
    "Give each other points. Take them away again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebt euch gegenseitig Punkte. Und zieht sie wieder ab."
          }
        }
      }
    },
    "How to delete it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So löschst du es"
          }
        }
      }
    },
    "Invitation" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einladung"
          }
        }
      }
    },
    "Invitation sent" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einladung verschickt"
          }
        }
      }
    },
    "Invite your partner" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade deinen Partner ein"
          }
        }
      }
    },
    "Invite your partner with a link, or look around with a demo partner first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade deinen Partner per Link ein oder sieh dich erst mit einem Demo-Partner um."
          }
        }
      }
    },
    "Know right away" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sofort Bescheid wissen"
          }
        }
